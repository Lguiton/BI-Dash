# Copy to .env (same folder) and fill in the keys you have. Never commit .env.
# The AI Lab uses every provider that has a key and spreads questions across them:
#   simple questions -> Google (Gemini) first, then OpenAI, then Claude
#   medium questions -> OpenAI first, then Google, then Claude   (comparisons, trends, summaries, drafts)
#   complex / code   -> Claude first (ML, deep learning, NLP, data science, statistics, math), then OpenAI, then Google
# The AI Lab and every discipline agent use the same rules. Force a tier in the AI Lab with the effort selector.
GOOGLE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Optional: choose models (defaults shown). If a provider says "unknown model", set one your account can use.
# BI_GOOGLE_MODEL=gemini-3.5-flash-lite
# BI_OPENAI_MODEL=gpt-4o-mini
# BI_AI_MODEL=claude-sonnet-5-5

# Optional: questions per provider per day before the router skips it (resets on restart)
# BI_LIMIT_GOOGLE=200
# BI_LIMIT_OPENAI=100
# BI_LIMIT_ANTHROPIC=150

# Optional: email the report from the dashboard (Gmail needs an app password; port 587 + starttls is typical)
# BI_SMTP_HOST=smtp.gmail.com
# BI_SMTP_PORT=587
# BI_SMTP_SECURITY=starttls
# BI_SMTP_USER=you@gmail.com
# BI_SMTP_PASSWORD=your-app-password
# BI_REPORT_TO=you@gmail.com          # the ONLY addresses reports may be sent to (comma separated)

# Other settings
# BI_DB_PATH=data/bi_warehouse.duckdb
# BI_CORS_ORIGINS=http://localhost:3012
# BI_SEED_DEMO=1

# Real-data use (see docs/REAL_USE.md)
# BI_SCHEDULER=1                 # 0 turns off scheduled source refreshes and the daily auto-backup
# BI_INBOX_DIR=data/inbox        # drop files here for the "File in a folder" source
# BI_SOURCE_DIRS=C:\Users\you\Exports   # more folders the file source may read (separate with ; or :)
# BI_BACKUP_DIR=data/backups
# Secrets for sources live here, never in the app. A source stores only the variable NAME:
# PG_URL=postgresql://readonly_user:password@host:5432/dbname
# MY_API_TOKEN=...

# Optional cost display in the AI Lab Usage tab (price per million tokens)
# BI_PRICE_GOOGLE_IN=
# BI_PRICE_GOOGLE_OUT=
# BI_PRICE_OPENAI_IN=
# BI_PRICE_OPENAI_OUT=
# BI_PRICE_ANTHROPIC_IN=
# BI_PRICE_ANTHROPIC_OUT=
# Alert emails reuse the BI_SMTP_* settings above.

# Where registered ML models are saved (default: next to the databases). Only load a folder you created yourself.
# BI_MODELS_DIR=
# Jupyter token for: docker compose --profile notebooks up
# JUPYTER_TOKEN=bi-notebooks

# --- Private login (turn on when the dashboard is online) ---
# BI_AUTH=1
# BI_OWNER_PASSWORD=choose-a-long-passphrase-12+chars
# BI_COOKIE_SECURE=1      # when served over HTTPS
# BI_SESSION_HOURS=168

# --- Calendar (read-only). Google Calendar > Settings > your calendar > "Secret address in iCal format" ---
# GOOGLE_CAL_ICAL_URL=https://calendar.google.com/calendar/ical/.../basic.ics
# BI_TZ=America/Los_Angeles   # time zone for event times

# --- Local AI through Ollama (free, private, works offline; last resort after Google and Claude) ---
# BI_OLLAMA_MODEL=llama3.1        # a model that supports tools: llama3.1, qwen2.5, mistral-nemo. Run: ollama pull llama3.1
# BI_OLLAMA_URL=http://127.0.0.1:11434

# --- Security / time zone ---
# Extra host names the app will answer to. Leave empty on your own computer (only localhost is allowed).
# BI_ALLOWED_HOSTS=
# Time zone for the morning briefing and daily schedules.
# BI_TZ=America/Los_Angeles

# Project AIDA link (optional; leave empty to keep it off). Add the product "bi-dashboard" in AIDA with an EMPTY Health URL.
AIDA_INTAKE_URL=
AIDA_INTAKE_SECRET=
