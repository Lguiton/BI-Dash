# Optional notebooks server for the practice notebooks. Build from the repository root:  docker compose --profile notebooks build notebooks
FROM python:3.12-slim
ENV PYTHONDONTWRITEBYTECODE=1 PYTHONUNBUFFERED=1
RUN pip install --no-cache-dir jupyterlab pandas duckdb pyarrow scikit-learn matplotlib seaborn
RUN useradd --create-home --uid 10001 nb && mkdir -p /work && chown nb /work
USER nb
WORKDIR /work
EXPOSE 8888
# the token comes from JUPYTER_TOKEN (see docker-compose.yml); the port is published on 127.0.0.1 only
CMD ["sh", "-c", "jupyter lab --ip=0.0.0.0 --port=8888 --no-browser --ServerApp.token=\"$JUPYTER_TOKEN\" --ServerApp.root_dir=/work"]
